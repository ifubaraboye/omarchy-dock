#!/usr/bin/env bash
set -euo pipefail

user_home="${HOME:?HOME is not set}"
icon_dir="$user_home/.config/omarchy/icons"
map_file="$user_home/.config/omarchy/dock-icons.json"
command_name="${0##*/}"
# Tests can inject a fake downloader through CURL_CMD.
curl_cmd="${CURL_CMD:-curl}"
max_download_size="10M"
max_page_size="2M"
max_image_width=4096
max_image_height=4096
max_image_pixels=16777216
# Remote search previews are untrusted and only ever displayed small: keep the
# local cache of them tight, private, and short-lived.
preview_cache_dir="$user_home/.cache/omarchy-dock/previews"
max_preview_size="2M"
max_preview_bytes=2097152
max_preview_width=512
max_preview_height=512
max_preview_pixels=262144
preview_ttl_days=30

# Temporary files are registered here and removed on any exit path, including
# die(), so a failed download/validation cannot leave partial images behind.
cleanup_files=()
cleanup() {
  (( ${#cleanup_files[@]} )) && rm -f -- "${cleanup_files[@]}"
  return 0
}
trap cleanup EXIT
# Run the EXIT cleanup even when Quickshell or timeout(1) terminates us.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

die() { printf '%s\n' "$command_name: $*" >&2; exit 1; }
usage() {
  cat <<'EOF'
Usage:
  omarchy-dock-icon search <query>
  omarchy-dock-icon preview <https-image-url>
  omarchy-dock-icon set <app-id> <macosicons-page-or-image-url>
  omarchy-dock-icon set <app-id> --file <local-image>
  omarchy-dock-icon clear <app-id>
  omarchy-dock-icon list
  omarchy-dock-icon folder
EOF
}

require_tools() {
  command -v python3 >/dev/null || die "python3 is required"
  command -v "$curl_cmd" >/dev/null || die "curl is required"
  command -v magick >/dev/null || command -v convert >/dev/null || die "ImageMagick is required"
  command -v identify >/dev/null || die "ImageMagick identify is required"
  command -v timeout >/dev/null || die "timeout is required"
}

canonical_id() {
  local value="$1"
  value="${value%.desktop}"
  [[ "$value" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid app id: $1"
  printf '%s' "$value"
}

search_icons() {
  local query="$1" payload
  payload="$(python3 -c 'import json, sys; print(json.dumps({"query": sys.argv[1], "searchOptions": {"filters": [], "hitsPerPage": 24, "page": 1, "sort": ["downloads:desc"]}}))' "$query")"
  { "$curl_cmd" -fsSL -A "Mozilla/5.0" --retry 2 --connect-timeout 10 --max-time 30 \
      --max-filesize "$max_page_size" \
      --proto '=https' --proto-redir '=https' \
      -X POST "https://macosicons.com/api/search" -H "Content-Type: application/json" \
      -d "$payload" 2>/dev/null || true; } | head -c "$max_page_size" | python3 /dev/fd/3 3<<'PY'
import json, sys

raw = sys.stdin.read()
try:
    data = json.loads(raw) if raw else {}
except (json.JSONDecodeError, TypeError):
    data = {}
hits = (data.get("hits") or []) if isinstance(data, dict) else []
out = []
for hit in hits:
    if not isinstance(hit, dict) or not hit.get("iOSUrl"):
        continue
    out.append({
        "appName": hit.get("appName", ""),
        "appSlug": hit.get("appSlug", ""),
        "objectID": hit.get("objectID", ""),
        "iOSUrl": hit.get("iOSUrl", ""),
        "lowResPngUrl": hit.get("lowResPngUrl", ""),
        "downloads": hit.get("downloads", 0),
    })
print(json.dumps(out, separators=(",", ":")))
PY
}

# A displayed search preview is fetched through this bounded, HTTPS-only path
# instead of handing the URL to Qt's image loader: the loader buffers the whole
# HTTP body before decoding, so a hostile or compromised preview endpoint could
# grow the shell's memory without any of the search/download limits applying.
# The helper caps the transfer, enforces a deadline, validates the decoded
# dimensions, and returns a private local path the picker can display.
preview_icon() {
  local url="$1" key target temporary format extension width height pixels
  [[ "$url" =~ ^https://[^[:space:]\"\']+$ ]] || die "preview URL must be a plain https URL"
  key="$(python3 -c 'import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode("utf-8")).hexdigest())' "$url")"

  for extension in png webp jpg; do
    if [[ -s "$preview_cache_dir/$key.$extension" ]]; then
      printf '%s\n' "$preview_cache_dir/$key.$extension"
      return 0
    fi
  done

  umask 077
  mkdir -p "$preview_cache_dir"
  chmod 700 "$(dirname "$preview_cache_dir")" "$preview_cache_dir" 2>/dev/null || true
  find "$preview_cache_dir" -maxdepth 1 -type f -mtime +"$preview_ttl_days" -delete 2>/dev/null || true

  temporary="$(mktemp "$preview_cache_dir/.${key}.XXXXXX")"
  cleanup_files+=("$temporary")

  # curl's --max-filesize also bounds bodies whose length is not advertised,
  # but piping through head -c applies a byte ceiling while receiving even if
  # the transfer tool changes; pipefail turns a truncated response into a
  # failure instead of caching a partial image.
  "$curl_cmd" -fsSL --retry 1 --connect-timeout 5 --max-time 15 \
    --max-redirs 3 --proto '=https' --proto-redir '=https' \
    --max-filesize "$max_preview_size" "$url" \
    | head -c "$max_preview_bytes" > "$temporary" \
    || die "preview download failed"

  format="$(timeout --foreground -k 2 15 identify -ping -format '%m' "$temporary" 2>/dev/null || true)"
  case "$format" in
    PNG) extension="png" ;;
    WEBP) extension="webp" ;;
    JPEG) extension="jpg" ;;
    *) die "preview is not a PNG, WebP, or JPEG image" ;;
  esac

  read -r width height < <(timeout --foreground -k 2 15 identify -ping -format '%w %h\n' "$temporary" 2>/dev/null) \
    || die "preview has invalid image dimensions"
  [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || die "preview has invalid image dimensions"
  (( width > 0 && height > 0 && width <= max_preview_width && height <= max_preview_height )) \
    || die "preview dimensions exceed ${max_preview_width}x${max_preview_height}"
  pixels=$((width * height))
  (( pixels <= max_preview_pixels )) || die "preview exceeds $max_preview_pixels pixels"

  target="$preview_cache_dir/$key.$extension"
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$target"
  printf '%s\n' "$target"
}

extract_image_url() {
  local html_file="$1" source="$2"
  python3 - "$html_file" "$source" <<'PY'
import html, re, sys

page = open(sys.argv[1], encoding="utf-8", errors="replace").read()
source = sys.argv[2]
urls = re.findall(r'https://[^"\'<>\s]+?\.(?:png|webp)(?:\?[^"\'<>\s]*)?', page)
urls = [html.unescape(url.replace("\\/", "/")) for url in urls]

def useful(url):
    return "/parse/" in url and "low_res_" not in url and "lowResPng" not in url

preferred = [url for url in urls if useful(url) and (re.search(r"(?:^|[_-])ios(?:[_-]|$)", url, re.I) or source.lower() in url.lower())]
fallback = [url for url in urls if useful(url)]
if not fallback:
    fallback = [url for url in urls if "/parse/" in url and "low_res_" not in url]
if preferred:
    print(preferred[0])
elif fallback:
    print(fallback[0])
else:
    raise SystemExit("no downloadable image URL found on page")
PY
}

round_icon() {
  local source="$1" destination="$2" tool width height pixels radius masked
  if command -v magick >/dev/null; then tool="magick"; else tool="convert"; fi

  # Check dimensions before any operation that decodes the image pixels.
  read -r width height < <(timeout --foreground -k 2 15 identify -ping -format '%w %h\n' "$source" 2>/dev/null) \
    || die "downloaded file has invalid image dimensions"
  [[ "$width" -le "$max_image_width" && "$height" -le "$max_image_height" ]] \
    || die "image dimensions exceed ${max_image_width}x${max_image_height} pixels"
  pixels=$((width * height))
  (( pixels <= max_image_pixels )) \
    || die "image dimensions exceed $max_image_pixels pixels"

  # Remove transparent padding so icons with a small painted logo do not
  # appear smaller than the rest of the dock.
  timeout --foreground -k 2 30 "$tool" "$source" -trim +repage "$destination"
  width="$(timeout --foreground -k 2 15 identify -ping -format '%w' "$destination")"
  height="$(timeout --foreground -k 2 15 identify -ping -format '%h' "$destination")"
  radius=$(( (width < height ? width : height) * 22 / 100 ))
  masked="${destination}.masked"
  cleanup_files+=("$masked")
  timeout --foreground -k 2 30 "$tool" "$destination" -alpha on \
    \( -size "${width}x${height}" xc:none -fill white \
       -draw "roundrectangle 0,0 $((width - 1)),$((height - 1)) $radius,$radius" \) \
    -compose DstIn -composite "$masked"
  mv -f -- "$masked" "$destination"
}

write_mapping() {
  local app_id="$1" filename="$2" source="$3" image_url="$4"
  mkdir -p "$(dirname "$map_file")"
  python3 - "$map_file" "$app_id" "$filename" "$source" "$image_url" <<'PY'
import json, os, sys, tempfile

path, app_id, filename, source, image_url = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
    if not isinstance(data, dict):
        data = {}
except (FileNotFoundError, json.JSONDecodeError):
    data = {}

data[app_id] = {
    "file": filename,
    "source": source,
    "imageUrl": image_url,
}
directory = os.path.dirname(path) or "."
fd, temporary = tempfile.mkstemp(prefix=".dock-icons.", dir=directory, text=True)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, path)
except Exception:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
}

set_icon() {
  local app_id input source image_url temporary filename
  app_id="$(canonical_id "$1")"
  input="$2"
  mkdir -p "$icon_dir"
  temporary="$(mktemp "$icon_dir/.${app_id}.XXXXXX")"
  cleanup_files+=("$temporary")

  if [[ "$input" == "--file" ]]; then
    [[ -f "$3" ]] || die "image file not found: $3"
    source="file:$3"
    image_url=""
    cp -- "$3" "$temporary"
  else
    source="$input"
    if [[ "$input" =~ ^https://s3-new\.macosicons\.com/ ]]; then
      image_url="$input"
    else
      if [[ "$input" =~ ^https://macosicons\.com/ ]]; then
        source="$input"
      elif [[ "$input" =~ ^https:// ]]; then
        # Any direct HTTPS image URL (GitHub assets, personal hosting, ...).
        # The downloaded bytes are still validated as PNG/WebP below.
        image_url="$input"
      else
        source="https://macosicons.com/icon/$input"
      fi
      if [[ -z "$image_url" ]]; then
        local page_file
        page_file="$(mktemp)"
        cleanup_files+=("$page_file")
        "$curl_cmd" -fL --retry 2 --connect-timeout 10 --max-time 30 \
          --proto '=https' --proto-redir '=https' --max-filesize "$max_page_size" \
          -o "$page_file" "$source"
        image_url="$(extract_image_url "$page_file" "$input")"
      fi
    fi
    "$curl_cmd" -fL --retry 2 --connect-timeout 10 --max-time 60 \
      --proto '=https' --proto-redir '=https' --max-filesize "$max_download_size" \
      -o "$temporary" "$image_url"
  fi

  # Validate the downloaded asset as an image. The downloaded bytes are never
  # passed to a shell or interpreter; ImageMagick only inspects the file type.
  local image_format
  image_format="$(timeout --foreground -k 2 15 identify -ping -format '%m' "$temporary" 2>/dev/null || true)"
  case "$image_format" in
    PNG|WEBP) ;;
    *) die "downloaded file is not a valid PNG or WebP image" ;;
  esac

  local rounded
  rounded="$(mktemp "$icon_dir/.${app_id}.rounded.XXXXXX.png")"
  cleanup_files+=("$rounded")
  round_icon "$temporary" "$rounded"
  filename="$app_id.png"
  mv -f -- "$rounded" "$icon_dir/$filename"
  write_mapping "$app_id" "$filename" "$source" "$image_url"
  printf 'Set custom icon for %s\n' "$app_id"
}

clear_icon() {
  local app_id="$1" filename
  app_id="$(canonical_id "$app_id")"
  filename="$(python3 - "$map_file" "$app_id" <<'PY'
import json, os, sys, tempfile
path, app_id = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
except (FileNotFoundError, json.JSONDecodeError):
    data = {}
entry = data.pop(app_id, None) if isinstance(data, dict) else None
directory = os.path.dirname(path) or "."
if isinstance(data, dict):
    fd, temporary = tempfile.mkstemp(prefix=".dock-icons.", dir=directory, text=True)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, path)
if isinstance(entry, dict):
    print(entry.get("file", ""))
elif isinstance(entry, str):
    print(entry)
PY
)"
  if [[ -n "$filename" && "$filename" != */* ]]; then rm -f -- "$icon_dir/$filename"; fi
  printf 'Cleared custom icon for %s\n' "$app_id"
}

list_icons() {
  python3 - "$map_file" "$user_home/.config/omarchy/dock-pinned-macos.json" <<'PY'
import json, os, sys
map_path, pins_path = sys.argv[1:]
def load(path, fallback):
    try:
        with open(path, encoding="utf-8") as handle: return json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError): return fallback
icons = load(map_path, {})
pins = load(pins_path, {})
pinned = pins.get("pinned", []) if isinstance(pins, dict) else pins
for app_id in pinned:
    entry = icons.get(str(app_id), {}) if isinstance(icons, dict) else {}
    filename = entry.get("file", "") if isinstance(entry, dict) else entry
    print(f"{app_id}: {filename or 'default icon'}")
PY
}

require_tools
case "${1:-}" in
  search) [[ $# -eq 2 ]] || { usage; exit 2; }; search_icons "$2" ;;
  preview) [[ $# -eq 2 ]] || { usage; exit 2; }; preview_icon "$2" ;;
  set)
    [[ $# -ge 3 ]] || { usage; exit 2; }
    if [[ "$3" == "--file" ]]; then
      [[ $# -eq 4 ]] || { usage; exit 2; }
      set_icon "$2" "$3" "$4"
    else
      [[ $# -eq 3 ]] || { usage; exit 2; }
      set_icon "$2" "$3"
    fi
    ;;
  clear) [[ $# -eq 2 ]] || { usage; exit 2; }; clear_icon "$2" ;;
  list) [[ $# -eq 1 ]] || { usage; exit 2; }; list_icons ;;
  folder) [[ $# -eq 1 ]] || { usage; exit 2; }; mkdir -p "$icon_dir"; xdg-open "$icon_dir" >/dev/null 2>&1 & ;;
  *) usage; exit 2 ;;
esac
